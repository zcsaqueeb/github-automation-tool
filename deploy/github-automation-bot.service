# systemd unit for running the bot directly on a Linux VPS (no Docker).
#
# Install:
#   sudo cp deploy/github-automation-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now github-automation-bot
#
# Logs:
#   journalctl -u github-automation-bot -f
#
# Edit the paths below (WorkingDirectory, ExecStart, User) to match your
# server before installing.

[Unit]
Description=GitHub AI Repo Bot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/github-automation-bot
EnvironmentFile=/opt/github-automation-bot/.env
ExecStart=/opt/github-automation-bot/.venv/bin/python /opt/github-automation-bot/bot.py
Restart=on-failure
RestartSec=5
# Cap restart attempts to avoid a crash-loop hammering Telegram's API.
StartLimitIntervalSec=300
StartLimitBurst=10

# ── Sandboxing (defense in depth) ────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/github-automation-bot
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
